diff --git a/src/utils/snapshot.js b/src/utils/snapshot.js
new file mode 100644
--- /dev/null
+++ b/src/utils/snapshot.js
@@ -0,0 +1,11 @@
+import { writable } from "svelte/store";
+import data from "../data/snapshot.json";
+export { data };
+export const staleAfter = 20 * 60 * 1000;
+export const isFresh = (now = Date.now()) => {
+  const times = [data.generatedAt, data.checkedAt].map(Date.parse);
+  return data.monitorSucceeded && times.every(time => Number.isFinite(time) && time <= now + 60000 && now - time < staleAfter);
+};
+export const fresh = writable(isFresh());
+export const refreshFreshness = () => fresh.set(isFresh());
+export const getSummary = async () => data.sites;
